#!/bin/sh
set -e
update-desktop-database /usr/share/applications || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
chmod 0440 /etc/sudoers.d/burrow || true

REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || true)}"
if [ -n "$REAL_USER" ]; then
    USER_ID=$(id -u "$REAL_USER" 2>/dev/null || true)
    if [ -n "$USER_ID" ]; then
        DBUS="unix:path=/run/user/${USER_ID}/bus"
        # Launch the app into the user's session
        su - "$REAL_USER" -c \
            "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=${DBUS} nohup /usr/local/bin/burrow-vpn >/dev/null 2>&1 &" \
            2>/dev/null || true
    fi
fi
